{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zuizui0223/adaptive-gain/planning/AEDES_PHASE_RECEIPT_SCHEMA_V1.json",
  "title": "Aedes causal experiment phase receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "protocol_git_sha",
    "phase",
    "background",
    "confirmatory",
    "primary_endpoint",
    "blocks",
    "exclusions",
    "primary_contrasts",
    "control_gate",
    "terminal_class",
    "next_phase_unlocked"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "protocol_git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "phase": {
      "type": "string",
      "enum": ["P1_LVP_STATE_PERTURBATION", "P2_LVP_B_CHANNEL", "P3_COMPOSITE_R_ROUTING"]
    },
    "background": {
      "type": "string",
      "minLength": 1
    },
    "confirmatory": {
      "const": true
    },
    "primary_endpoint": {
      "type": "string",
      "minLength": 1
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_id", "n_started", "n_analyzed"],
        "properties": {
          "block_id": {"type": "string", "minLength": 1},
          "n_started": {"type": "integer", "minimum": 1},
          "n_analyzed": {"type": "integer", "minimum": 0}
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit_id", "reason"],
        "properties": {
          "unit_id": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "predeclared_reason": {"type": "boolean"}
        }
      }
    },
    "primary_contrasts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contrast_id",
          "estimate",
          "interval_low",
          "interval_high",
          "direction_pass",
          "multiplicity_pass"
        ],
        "properties": {
          "contrast_id": {"type": "string", "minLength": 1},
          "estimate": {"type": "number"},
          "interval_low": {"type": "number"},
          "interval_high": {"type": "number"},
          "direction_pass": {"type": "boolean"},
          "multiplicity_pass": {"type": "boolean"}
        }
      }
    },
    "control_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "pass"],
      "properties": {
        "gate_id": {
          "type": "string",
          "enum": [
            "P1_GENERAL_PERFORMANCE_AND_SPECIFICITY",
            "P2_DIRECT_PLACEMENT_COMPETENCE",
            "P3_SINGLE_R_INTEGRATION"
          ]
        },
        "pass": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "terminal_class": {
      "type": "string",
      "enum": ["GO", "UNRESOLVED", "STOP"]
    },
    "next_phase_unlocked": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"terminal_class": {"const": "GO"}},
        "required": ["terminal_class"]
      },
      "then": {
        "properties": {"next_phase_unlocked": {"const": true}}
      }
    },
    {
      "if": {
        "properties": {"terminal_class": {"enum": ["UNRESOLVED", "STOP"]}},
        "required": ["terminal_class"]
      },
      "then": {
        "properties": {"next_phase_unlocked": {"const": false}}
      }
    }
  ]
}
